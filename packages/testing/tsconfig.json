{
  "extends": "@cli-contract/typescript-config/base.json",
  "compilerOptions": {
    "declaration": true,
    "erasableSyntaxOnly": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "paths": {
      "#/*": ["./src/*.ts"],
      "@ykdz/cli-contract": ["../lib/src/index.ts"],
      "@ykdz/cli-contract-testing": ["./src/index.ts"]
    },
    "rewriteRelativeImportExtensions": true,
    "target": "es2023",
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
