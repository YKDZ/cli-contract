{
  "name": "@ykdz/cli-contract-testing",
  "version": "0.4.0",
  "description": "Consumer test scenarios for @ykdz/cli-contract.",
  "keywords": [
    "cli",
    "contract",
    "nodejs",
    "testing",
    "typescript"
  ],
  "homepage": "https://github.com/YKDZ/cli-contract",
  "bugs": {
    "url": "https://github.com/YKDZ/cli-contract/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YKDZ/cli-contract.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json --pretty false && link-example",
    "format:check": "oxfmt --list-different .",
    "format:write": "oxfmt --write .",
    "lint": "oxlint --quiet --format=unix --ignore-pattern node_modules .",
    "lint:fix": "oxlint --format=unix . --fix",
    "test": "node --test --conditions=source test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false"
  },
  "dependencies": {
    "@ykdz/cli-contract": "workspace:*"
  },
  "devDependencies": {
    "@cli-contract/tooling-config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript-7": "catalog:"
  },
  "engines": {
    "node": "^26.13.0"
  }
}
