{
  "name": "@boringparts/cli-contract",
  "version": "0.7.0",
  "description": "Catch unhandled CLI outcomes at compile time.",
  "keywords": [
    "cli",
    "contract",
    "nodejs",
    "typescript"
  ],
  "homepage": "https://github.com/boringparts/cli-contract",
  "bugs": {
    "url": "https://github.com/boringparts/cli-contract/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boringparts/cli-contract.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./package.json": {
      "types": "./package.json",
      "default": "./package.json"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json --pretty false && node scripts/link-example.ts",
    "format:check": "oxfmt --list-different .",
    "format:write": "oxfmt --write .",
    "lint": "oxlint --quiet --format=unix --ignore-pattern node_modules .",
    "lint:fix": "oxlint --format=unix . --fix",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0"
  },
  "devDependencies": {
    "@cli-contract/tooling-config": "workspace:*",
    "@types/node": "~24.0.0",
    "@valibot/to-json-schema": "^1.7.1",
    "ajv": "^8.20.0",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript-7": "catalog:",
    "valibot": "^1.5.0",
    "zod": "^4.6.5"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.0.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
