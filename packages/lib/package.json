{
  "name": "@ykdz/cli-contract",
  "version": "0.4.0",
  "description": "Framework-agnostic, executable CLI contracts for Node.js.",
  "keywords": [
    "cli",
    "contract",
    "nodejs",
    "typescript"
  ],
  "homepage": "https://github.com/YKDZ/cli-contract",
  "bugs": {
    "url": "https://github.com/YKDZ/cli-contract/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YKDZ/cli-contract.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./package.json": {
      "types": "./package.json",
      "default": "./package.json"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "authoring:fixture:hierarchy-text-coverage": "cat test/hierarchy-text-coverage.typecheck.ts",
    "build": "tsc -p tsconfig.build.json --pretty false && link-example",
    "format:check": "oxfmt --list-different .",
    "format:write": "oxfmt --write .",
    "lint": "oxlint --quiet --format=unix --ignore-pattern node_modules .",
    "lint:fix": "oxlint --format=unix . --fix",
    "test": "node --test --conditions=source test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0",
    "@types/node": "catalog:"
  },
  "devDependencies": {
    "@cli-contract/tooling-config": "workspace:*",
    "@valibot/to-json-schema": "^1.8.0",
    "ajv": "^8.20.0",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript-7": "catalog:",
    "valibot": "^1.5.0",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": "^26.13.0"
  }
}
