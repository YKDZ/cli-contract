{
  "name": "@ykdz/cli-contract",
  "version": "0.1.1",
  "description": "Framework-agnostic, executable CLI contracts for Node.js.",
  "keywords": [
    "cli",
    "contract",
    "nodejs",
    "typescript"
  ],
  "homepage": "https://github.com/YKDZ/cli-contract",
  "bugs": {
    "url": "https://github.com/YKDZ/cli-contract/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YKDZ/cli-contract.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json --pretty false",
    "format:check": "oxfmt --list-different --config ../../oxfmt.config.ts .",
    "format:write": "oxfmt --write --config ../../oxfmt.config.ts .",
    "lint": "oxlint --quiet --format=unix --config ../../oxlint.config.ts --ignore-pattern node_modules .",
    "lint:fix": "oxlint --format=unix --config ../../oxlint.config.ts . --fix",
    "test": "node --test --conditions=source test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0",
    "@types/node": "catalog:"
  },
  "devDependencies": {
    "@cli-contract/typescript-config": "workspace:*",
    "@valibot/to-json-schema": "^1.7.1",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript-7": "catalog:",
    "valibot": "^1.4.2",
    "zod": "^4.5.4"
  },
  "engines": {
    "node": ">=24"
  }
}
